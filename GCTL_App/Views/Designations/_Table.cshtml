<div class="d-flex flex-column">
    <div class="card shadow rounded-2 flex-grow-1 d-flex">

        <!-- Header -->
        <div class="card-header bg-light rounded-top-2">
            <div class="row align-items-center">

                <!-- Page Size -->
                <div class="col-md-6 d-flex align-items-center">
                    <label class="me-2 mb-0">@Html.SmartLocalize("Show")</label>

                    <select id="designation-pageSizeSelect"
                            class="form-select form-select-sm"
                            style="width:90px;">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>

                    <label class="ms-2 mb-0">@Html.SmartLocalize("Entries")</label>
                </div>

                <!-- Search -->
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <input type="text"
                           id="designation-searchInput"
                           class="form-control form-control-sm d-inline-block"
                           style="max-width:250px;"
                           placeholder="@Html.SmartLocalize("Search here")">
                </div>

            </div>
        </div>
        <div class="card-body p-2 flex-grow-1 d-flex flex-column">
            <!-- Table -->
            <div class="table-responsive flex-grow-1" style="overflow-y: auto; max-height: 600px;">

                <table class="table table-hover table-sm table-bordered mb-0">
                    <thead class="table-light align-middle text-nowrap sticky-top" style="font-size: 0.8rem;">

                        <tr>

                            <th class="text-center text-middle" style="width:50px;">
                                <input type="checkbox"
                                       id="designation-check-all"
                                       class="form-check-input">
                            </th>

                            <th class="text-center text-middle" style="width:100px;">
                                @Html.SmartLocalize("ID")
                                <i class="fa fa-sort text-secondary ms-1"></i>
                            </th>

                            <th class="text-center text-middle">
                                @Html.SmartLocalize("Designation Name")
                                <i class="fa fa-sort text-secondary ms-1"></i>
                            </th>

                            <th class="text-center text-middle" style="width:150px;">
                                @Html.SmartLocalize("Action")
                            </th>

                        </tr>
                    </thead>

                    <tbody id="designation-tBody">

                        <!-- Dynamic Rows -->

                        <tr class="no-data">
                            <td colspan="4" class="text-center py-4">
                                @Html.SmartLocalize("No data available")
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>
        </div>
        <!-- Information Row -->
        <div class="card-footer bg-light position-sticky bottom-0">

            <div class="row align-items-center mb-2">

                <!-- Left -->
                <div class="col-md-3 text-center text-md-start">
                    <span id="designation-pageInfo">
                        Page 1 of 1
                    </span>
                </div>

                <!-- Center -->
                <div class="col-md-6 text-center">
                    <span id="designation-paginationInfo"
                          class="text-primary">
                        Showing 1 to 10 Items of 10 entries
                    </span>
                </div>

                <!-- Right -->
                <div class="col-md-3 text-center text-md-end">
                    <span id="designation-totalRecords">
                        Total Records: 0
                    </span>
                </div>

            </div>

        </div>

        <!-- Pagination -->
        <div class="text-center pb-3">

            <div class="btn-group">

                <button id="designation-firstPage"
                        class="btn btn-outline-primary btn-sm">
                    First
                </button>

                <button id="designation-prevPageBtn"
                        class="btn btn-outline-primary btn-sm">
                    Previous
                </button>

            </div>

            <ul id="designation-paginationLinks"
                class="pagination d-inline-flex mx-2 mb-0 align-middle">

                <!-- Dynamic Page Numbers -->

                <li class="page-item active">
                    <a class="page-link" href="#">1</a>
                </li>

            </ul>

            <div class="btn-group">

                <button id="designation-nextPageBtn"
                        class="btn btn-outline-primary btn-sm">
                    Next
                </button>

                <button id="designation-lastPage"
                        class="btn btn-outline-primary btn-sm">
                    Last
                </button>

            </div>

        </div>

    </div>
</div>
