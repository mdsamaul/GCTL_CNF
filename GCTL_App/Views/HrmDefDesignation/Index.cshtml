@using GCTL.Core.ViewModels.MasterSetup.HrmDefDesignations;
@model HrmDefDesignationViewModel;
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali&display=swap" rel="stylesheet">

<style>
    /* Changes Scroll CSS from me */
    .table-scroll-area {
        max-height: none;
        overflow: visible;
    }

        .table-scroll-area table {
            table-layout: fixed;
            width: 100%;
        }

        .table-scroll-area thead th {
            position: static;
            background-color: transparent;
            z-index: auto;
        }


    /* Make the card bodies stretch to fill available space */
    .card {
        display: flex;
        flex-direction: column;
      
    }

    .card-body {
        flex-grow: 1;
    }

    .table-card .card-body {
        padding: 0;
    }

    .paymentType-pagination-footer {
        flex: 0 0 auto;
        border-top: 1px solid #e0e0e0;
        padding: 8px 12px;
    }
  

   
</style>



<div class="mb-3 " style="display: flex;">
    <div class="card-body w-100 p-0">
        <div class="row g-2">
            <div class="col-md-6">
                @await Html.PartialAsync("_Setup", new HrmDefDesignationViewModel())
            </div>

            <div class="col-md-6">
                @await Html.PartialAsync("_Table")
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="~/js/pages/MasterSetup/hrmDefDesignationData.js"></script>

    <link href="~/lib/toastr.js/toastr.min.css" rel="stylesheet" />
    <script src="~/lib/toastr.js/toastr.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


}