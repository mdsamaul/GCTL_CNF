
<div class="d-flex flex-column">
    <div class="card shadow rounded-2 flex-grow-1 d-flex">

        <!-- Header -->
        <div class="card-header bg-light rounded-top-2">
            <div class="row align-items-center">

                <!-- Show Entries -->
                <div class="col-md-6 d-flex align-items-center mb-2 mb-md-0">
                    <label class="me-2 mb-0">Show</label>

                    <select id="designation-pageSize"
                            class="form-select form-select-sm me-2"
                            style="max-width:100px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="-1">All</option>
                    </select>

                    <label class="mb-0">Entries</label>
                </div>

                <!-- Search -->
                <div class="col-md-6 d-flex justify-content-md-end">
                    <input type="text"
                           id="designation-searchInput"
                           class="form-control form-control-sm"
                           style="max-width:300px;"
                           placeholder="Search...">
                </div>

            </div>
        </div>

        <!-- Body -->
        <div class="card-body p-2 flex-grow-1 d-flex flex-column">
            <div class="table-responsive flex-grow-1"
                 style="overflow-y:auto; max-height:600px;">

                <table class="table table-hover table-sm table-bordered mb-0">

                    <thead class="table-light text-nowrap sticky-top"
                           style="font-size:0.8rem;">
                        <tr>
                            <th class="text-center" style="width:6%">
                                <input type="checkbox"
                                       id="designation-check-all"
                                       class="form-check-input">
                            </th>

                            <th class="designation-sort text-center"
                                data-sort="DesignationCode"
                                style="width:6%">
                                ID
                            </th>

                            <th class="designation-sort text-start"
                                data-sort="DesignationName"
                                style="width:30%">
                                Designation
                            </th>

                            <th class="designation-sort text-center"
                                data-sort="DesignationShortName"
                                style="width:10%">
                                Short Name
                            </th>

                            <th class="designation-sort text-center"
                                data-sort="BanglaDesignation"
                                style="width:18%;font-family:'Noto Sans Bengali',sans-serif;">
                                Designation<br>
                                <small>(বাংলা)</small>
                            </th>

                            <th class="designation-sort text-center"
                                data-sort="BanglaShortName"
                                style="width:12%;font-family:'Noto Sans Bengali',sans-serif;">
                                Short Name<br>
                                <small>(বাংলা)</small>
                            </th>

                            <th class="designation-sort text-center"
                                data-sort="GradeCode"
                                style="width:8%">
                                Grade No
                            </th>

                            <th class="designation-sort text-center"
                                data-sort="StepNoId"
                                style="width:10%">
                                Step No
                            </th>
                        </tr>
                    </thead>

                    <tbody id="designation-table-body">
                        <tr class="no-data">
                            <td colspan="8" class="text-center">
                                No data available
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="card-footer bg-light">

            <div class="row align-items-center mb-2">
                <div class="col-12 text-center">
                    <span id="designation-paginationInfo"
                          class="fw-semibold text-primary"
                          style="font-size:0.85rem;">
                    </span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 text-center">

                    <div class="btn-group">
                        <button id="designation-firstPage"
                                class="btn btn-outline-primary btn-sm">
                            First
                        </button>

                        <button id="designation-prevPageBtn"
                                class="btn btn-outline-primary btn-sm">
                            Previous
                        </button>
                    </div>

                    <ul id="designation-paginationLinks"
                        class="pagination justify-content-center d-inline-flex mx-2 mb-0">
                    </ul>

                    <div class="btn-group">
                        <button id="designation-nextPageBtn"
                                class="btn btn-outline-primary btn-sm">
                            Next
                        </button>

                        <button id="designation-lastPage"
                                class="btn btn-outline-primary btn-sm">
                            Last
                        </button>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>

