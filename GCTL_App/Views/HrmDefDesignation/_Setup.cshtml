<style>
    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }



</style>

@model GCTL.Core.ViewModels.MasterSetup.HrmDefDesignations.HrmDefDesignationViewModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0" >Designation</h5>
        <div class="d-flex flex-wrap align-items-center gap-1">
            <button type="submit" id="designation-btnSave" class="btn btn-light btn-sm text-dark rounded-start px-2 text-nowrap saveBtn">
                <i class="fas fa-save me-1"></i> Save
            </button>
            <button type="button" id="designation-btnDelete" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="button" id="designation-btnBulkDelete" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap d-none deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="reset" id="designation-resetBtn" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap resetBtn">
                <i class="fas fa-eraser me-1"></i> Clear
            </button>
            <button type="button" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap printBtn">
                <i class="fas fa-print me-1"></i> Print
            </button>
            <button type="button" class="btn btn-light btn-sm text-dark rounded-end px-2 text-nowrap favBtn">
                <i class="fas fa-star me-1"></i> Fav
            </button>
        </div>
    </div>

    <div class="card-body">
        <form id="designation-Form">
            <input type="hidden" asp-for="AutoId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text"  class="form-control" asp-for="DesignationCode" placeholder="" readonly />
                        <label for="DesignationCode">Designation ID</label>
                    </div>
                </div>
                <div class="col-md-6"></div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text"  class="form-control" asp-for="DesignationName" placeholder="Designation" />
                        <label asp-for="DesignationName">Designation <span style="color:red">*</span></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="DesignationShortName" placeholder="Enter Short Name" />
                        <label for="DesignationShortName">Short Name</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="BanglaDesignation" placeholder="Enter Short Name" />
                        <label for="BanglaDesignation">Designation (বাংলা)</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="BanglaShortName" placeholder="Enter Short Name" />
                        <label for="BanglaShortName">Short Name(বাংলা)</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="GradeCode" placeholder="Enter Short Name" />
                        <label for="GradeCode">Grade No</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="StepNoId" placeholder="Step No" />
                        <label for="StepNoId">Step No</label>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer d-flex justify-content-between text-muted small d-none" id="designation-footer">
        <div id="entryDate">Entry Date: --</div>
        <div id="lastUpdateDate">Last Updated: --</div>
    </div>
</div>