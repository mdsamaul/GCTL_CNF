<div class="card shadow-sm rounded-2">
    <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <h4 class="mb-0">Bank Account Info</h4>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" id="accountSaveBtn" class="btn btn-sm btn-outline-primary accountSaveBtn">
                <i class="fas fa-save me-1"></i> Save
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger accountDeleteBtn" id="accountDeleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="reset" class="btn btn-sm btn-outline-secondary accountResetBtn">
                <i class="fas fa-eraser me-1"></i> Clear
            </button>
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                    <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                </ul>
            </div>
            <button type="button" class="btn btn-sm btn-outline-warning accountFavBtn">
                <i class="fas fa-star me-1"></i> Fav
            </button>
        </div>
    </div>

    <div class="card-body">
        <form id="accountForm">
            <input type="hidden" id="accountAutoID" name="accountAutoID" />

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input readonly type="text" class="form-control" name="accountID" id="accountID" placeholder="Enter Account ID">
                        <label for="accountID">Account Info ID</label>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="accountBank" id="accountBank"></select>
                        <label for="accountBank">Bank Name</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="branch" id="branch"></select>
                        <label for="branch">Branch Name</label>
                    </div>
                </div>

                
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="accountName" id="accountName" placeholder="Enter Account Name">
                        <label for="accountName">Account Name<span style="color:red">*</span></label>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="accountNumber" id="accountNumber" placeholder="Enter Account NO">
                        <label for="accountNumber">Account No<span style="color:red">*</span></label>
                    </div>
                </div>
              

                @* <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="companyCode" id="companyCode" placeholder="Enter Company Code">
                        <label for="companyCode">Company Code</label>
                    </div>
                </div> *@


                

                @* <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="userInfoEmployeeID" id="userInfoEmployeeID">
                        </select>
                        <label for="userInfoEmployeeID">User ID</label>
                    </div>
                </div> *@

            </div>



            <!-- Creation/Modify Date Display -->
            <div class="row g-3 mt-2">
                <div class="col-md-6" id="accountLDateContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted small">Creation Date</label>
                    <div id="displayAccountLDate" class="bg-white p-3 border rounded-3"></div>
                </div>
                <div class="col-md-6" id="accountModifyDateContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted small">Modify Date</label>
                    <div id="displayAccountModifyDate" class="bg-white p-3 border rounded-3"></div>
                </div>
            </div>


            <!-- Save Button (Bottom) -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary btn-sm accountSaveBtn">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>









