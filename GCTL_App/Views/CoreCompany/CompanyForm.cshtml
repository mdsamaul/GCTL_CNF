<style>
    .form-floating .selectLabel {
        font-size: 14px !important; /* Use a larger value and !important if necessary */
    }

    .form-floating label {
        text-transform: none; /* Keeps the original casing */
        font-size: 13px; /* Adjust the font size as needed */
    }

    .saveBtn:hover {
        color: darkgreen !important; /* or any color you want */
        background-color: lightgray !important; /* optional: blue background */
    }

    .deleteBtn:hover {
        color: red !important; /* or any color you want */
        background-color: lightgray !important; /* optional: blue background */
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important; /* or any color you want */
        background-color: lightgray !important; /* optional: blue background */
    }

    .printBtn:hover {
        color: blue !important; /* or any color you want */
        background-color: lightgray !important; /* optional: blue background */
    }

    .favBtn:hover {
        color: orangered !important; /* or any color you want */
        background-color: lightgray !important; /* optional: blue background */
    }

    #button-div button {
        padding: 8px 6px;
        width: 80px;
    }

    .select2-container .select2-selection--single {
        height: 50px !important; 
        padding: 8px 12px;
        font-size: 16px;

    }


    .select2-container--default .select2-selection--single .select2-selection__arrow b {
        
        border-width: 8px 6px 0 6px !important;
        
        left: 10% !important;
      
        top: 85% !important;
      
    }



</style>

<div class="card shadow-sm rounded-2">
    <div class="px-1 card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex flex-nowrap justify-content-between w-100 align-items-center">

            <div>
                <h4 class="mb-0 heading-nowrap " style="font-size:14px">Company Information</h4>
            </div>
            <div class="d-flex gap-1" id="button-div">
                <button type="submit" form="CompanyForm" class="btn btn-sm btn-outline-primary saveBtn">
                    <i class="fas fa-save me-1"></i> Save
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger deleteBtn" id="deleteBtn">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>
                <button type="reset" class="btn btn-sm btn-outline-secondary resetBtn">
                    <i class="fas fa-eraser me-1"></i> Clear
                </button>
                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                        <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                    </ul>
                </div>
                <button type="button" class="btn btn-sm btn-outline-warning favBtn">
                    <i class="fas fa-star me-1"></i> Fav
                </button>
            </div>
        </div>
    </div>

    <div class="card-body">
        <form id="CompanyForm">
            <fieldset style="border:1px solid #ccc; padding:5px; border-radius:5px;">

                <input type="hidden" id="autoID" name="autoID" />

                <div class="row g-3 mb-2">

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input readonly type="text" class="form-control" name="CompanyCode" id="CompanyCode">
                            <label for="CompanyCode">Company ID</label>
                        </div>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="CompanyName" id="CompanyName">
                            <label for="CompanyName">Company Name<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="CompanyShortName" id="CompanyShortName">
                            <label for="CompanyShortName">Short Name</label>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="Address1" id="Address1">
                            <label for="Address1">Address1<span style="color:red">*</span></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="Address2" id="Address2">
                            <label for="Address2">Address2</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="CompanyBanglaName" id="CompanyBanglaName">
                            <label for="CompanyBanglaName">Company Name(বাংলা)</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="AddressBangla" id="AddressBangla">
                            <label for="AddressBangla">Address(বাংলা)</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="ZipCode" id="ZipCode">
                            <label for="ZipCode">Zip/Postal Code</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="City" id="City">
                            <label for="City">City</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="State" id="State">
                            <label for="State">State/Division</label>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-control " name="Country" id="Country">
                            </select>
                            <label for="Country"></label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="Phone1" id="Phone1">
                            <label for="Phone1">Phone1</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="Phone2" id="Phone2">
                            <label for="Phone2">Phone2</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="BIN" id="BIN">
                            <label for="BIN">BIN</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="HotLine" id="HotLine">
                            <label for="HotLine">HotLine/Customer Care No</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="Email" id="Email">
                            <label for="Email">Email</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="URL" id="URL">
                            <label for="URL">Website</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="RegNo" id="RegNo">
                            <label for="RegNo">Business Reg. No</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="TIN" id="TIN">
                            <label for="TIN">Tax Identification No</label>
                        </div>
                    </div>
                    @* Currency Dropdown *@
            
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-control" name="BaseCurrency" id="BaseCurrency">
                            </select>
                            <label for="BaseCurrency"> </label>
                        </div>
                    </div>




                </div>

                <!-- Creation/Modify Date Display -->
                @* <div class="row g-3 mt-2">
                    <div class="col-md-6" id="lDateContainer" style="display: none;">
                        <label class="form-label fw-bold text-muted small">Creation Date</label>
                        <div id="displayLDate" class="bg-white p-3 border rounded-3"></div>
                    </div>
                    <div class="col-md-6" id="modifyDateContainer" style="display: none;">
                        <label class="form-label fw-bold text-muted small">Modify Date</label>
                        <div id="displayModifyDate" class="bg-white p-3 border rounded-3"></div>
                    </div>
                </div> *@
                <hr class="my-4 mx-2 pb-2">

                <div class="row g-3">

                    <div class="col-md-6">
                        <div>
                            <span>Entry Date : </span>
                            <span id="lDateContainer"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div>
                            <span>Last Update Date :</span>
                            <span id="modifyDateContainer"></span>
                        </div>
                    </div>

                </div>

                <!-- Save Button (Bottom) -->
                <div class="row mt-4">
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="btn btn-outline-primary btn-sm saveBtn">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </fieldset>
        </form>
    </div>
</div>









