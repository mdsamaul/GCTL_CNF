
<h1 class="text-center">Accounts Management</h1>
<div class="container container-fluid">
    <ul class="nav nav-tabs" id="bankTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="bank-tab" data-bs-toggle="tab" href="#bank-tab-pane" role="tab">Bank Info</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="branch-tab" data-bs-toggle="tab" href="#branch-tab-pane" role="tab">Bank Branch Info</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="account-tab" data-bs-toggle="tab" href="#account-tab-pane" role="tab">Bank Account Info</a>
        </li>
    </ul>

    <div class="tab-content" id="bankTabContent">
        <div class="tab-pane fade show active" id="bank-tab-pane" role="tabpanel" aria-labelledby="bank-tab">
            <div id="bankTabView"></div>
        </div>
        <div class="tab-pane fade" id="branch-tab-pane" role="tabpanel" aria-labelledby="branch-tab">
            <div id="branchTabView"></div>
        </div>
        <div class="tab-pane fade" id="account-tab-pane" role="tabpanel" aria-labelledby="account-tab">
            <div id="accountTabView"></div>
        </div>

    </div>
</div>


@section Scripts {
	
    <script>
        $(document).ready(function () {
            $('#bankTabView').load('/AccountsManagement/BankInfo');
            $('#branchTabView').load('/AccountsManagement/BankBranchInfo');
            $('#accountTabView').load('/AccountsManagement/BankAccountInfo');
        });
    </script> 
   
}
