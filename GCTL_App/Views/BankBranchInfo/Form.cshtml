<div class="card shadow-sm rounded-2">
    <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center flex-wrap">
        <h4 class="mb-0">Bank Branch Info</h4>
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" id="branchSaveBtn" form="branchForm" class="btn btn-sm btn-outline-primary branchSaveBtn">
                <i class="fas fa-save me-1"></i> Save
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger branchDeleteBtn" id="branchDeleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="reset" class="btn btn-sm btn-outline-secondary branchResetBtn">
                <i class="fas fa-eraser me-1"></i> Clear
            </button>
            <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="fas fa-print me-1"></i> Print
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item export-pdf" href="#"><i class="fas fa-file-pdf me-1"></i> PDF</a></li>
                    <li><a class="dropdown-item export-excel" href="#"><i class="fas fa-file-excel me-1"></i> Excel</a></li>
                </ul>
            </div>
            <button type="button" class="btn btn-sm btn-outline-warning branchFavBtn">
                <i class="fas fa-star me-1"></i> Fav
            </button>
        </div>
    </div>

    <div class="card-body">
        <form id="branchForm">
            <input type="hidden" id="branchAutoID" name="branchAutoID" />

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input readonly type="text" class="form-control" name="branchID" id="branchID" placeholder="Enter Branch ID">
                        <label for="branchID">Branch ID</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select class="form-select" name="bank" id="bank"></select>
                        <label for="bank">Bank Name<span style="color:red">*</span></label>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="branchName" id="branchName" placeholder="Enter Branch Name">
                        <label for="branchName">Branch Name<span style="color:red">*</span></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="branchShortName" id="branchShortName" placeholder="Enter Short Name">
                        <label for="branchShortName">Short Name</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="swiftCode" id="swiftCode" placeholder="Enter Swift Code">
                        <label for="swiftCode">Swift Code</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="branchAddress" id="branchAddress" placeholder="Enter Branch Address">
                        <label for="branchAddress">Address</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" name="branchPhone" id="branchPhone" placeholder="Enter Phone">
                        <label for="branchPhone">Phone</label>
                    </div>
                </div>


            </div>


            <!-- Creation/Modify Date Display -->
            <div class="row g-3 mt-2">
                <div class="col-md-6" id="branchLDateContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted small">Creation Date</label>
                    <div id="displayBranchLDate" class="bg-white p-3 border rounded-3"></div>
                </div>
                <div class="col-md-6" id="branchModifyDateContainer" style="display: none;">
                    <label class="form-label fw-bold text-muted small">Modify Date</label>
                    <div id="displayBranchModifyDate" class="bg-white p-3 border rounded-3"></div>
                </div>
            </div>


            <!-- Save Button (Bottom) -->
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-outline-primary btn-sm branchSaveBtn">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>









