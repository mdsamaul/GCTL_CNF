<style>
    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }
</style>

@model GCTL.Core.ViewModels.MasterSetup.CoreCountries.CoreCountryViewModel

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Country</h5>
        <div>
            <button type="submit" id="country-btnSave" class="btn btn-light btn-sm text-dark rounded-start px-2 text-nowrap saveBtn">
                <i class="fas fa-save me-1"></i> Save
            </button>
            <button type="button" id="country-btnDelete" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="button" id="country-btnBulkDelete" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap d-none deleteBtn">
                <i class="fas fa-trash me-1"></i> Delete
            </button>
            <button type="reset" id="country-resetBtn" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap resetBtn">
                <i class="fas fa-eraser me-1"></i> Clear
            </button>
            <button type="button" class="btn btn-light btn-sm text-dark rounded px-2 text-nowrap printBtn">
                <i class="fas fa-print me-1"></i> Print
            </button>
            <button type="button" class="btn btn-light btn-sm text-dark rounded-end px-2 text-nowrap favBtn">
                <i class="fas fa-star me-1"></i> Fav
            </button>
        </div>
    </div>

    <div class="card-body">
        <form id="country-Form">
            <input type="hidden" asp-for="CountryCode" name="CountryCode" id="CountryCode" />
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="CountryId" placeholder="Country ID" readonly />
                        <label for="CountryId">Country ID</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="CountryName" placeholder="CountryName" />
                        <label asp-for="CountryName">Country Name<span style="color:red">*</span></label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="Ioccode" placeholder="Enter Ioccode" />
                        <label for="Ioccode">IOC Code</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input type="text" class="form-control" asp-for="Isocode" placeholder="Enter Isocode" />
                        <label for="Isocode">ISO Code</label>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <div class="card-footer d-flex justify-content-between text-muted small d-none" id="country-footer">
        <div id="entryDate">Entry Date: --</div>
        <div id="lastUpdateDate">Last Updated: --</div>
    </div>
</div>