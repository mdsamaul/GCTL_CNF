@{
    ViewData["Title"] = "Index";
}
<!-- Add FontAwesome for sort icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

<style>
    .custom-table td {
        padding: 0 !important;
        text-align: center !important;
        vertical-align: middle !important;
        font-size: 0.9rem;
    }

    .sortable {
        cursor: pointer;
        position: relative;
        user-select: none;
    }

        .sortable:hover {
            background-color: #f8f9fa;
        }

    .sort-icon {
        margin-left: 5px;
        opacity: 0.3;
    }

    .sort-asc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

    .sort-desc .sort-icon {
        opacity: 1;
        color: #0d6efd;
    }

    .sort-asc .sort-icon:before {
        content: "\f0de";
    }

    .sort-desc .sort-icon:before {
        content: "\f0dd";
    }

    .form-check-input {
        cursor: pointer;
    }

    .table {
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        border-radius: 5px;
    }

        .table thead th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
            font-weight: 600;
        }

    .btn-transfer {
        padding: 0.25rem 0.5rem;
        border: none;
        background: transparent;
        color: #0d6efd;
        text-decoration: underline;
        transition: all 0.2s;
    }

        .btn-transfer:hover {
            color: #0a58ca;
            text-decoration: none;
        }

    .form-floating .selectLabel {
        font-size: 14px !important;
    }

    .form-floating label {
        text-transform: none;
        font-size: 13px;
    }

    .saveBtn:hover {
        color: darkgreen !important;
        background-color: lightgray !important;
    }

    .deleteBtn:hover {
        color: red !important;
        background-color: lightgray !important;
    }

    .resetBtn:hover {
        color: lightgoldenrodyellow !important;
        background-color: lightgray !important;
    }

    .printBtn:hover {
        color: blue !important;
        background-color: lightgray !important;
    }

    .favBtn:hover {
        color: orangered !important;
        background-color: lightgray !important;
    }
</style>

<div class="row g-2">
    <div class="col-6" id="vendorPrefixFormView">
        @await Html.PartialAsync("VendorPrefixForm")
    </div>
    <div class="col-6" id="vendorPrefixListView">
        @await Html.PartialAsync("VendorPrefixList")
    </div>
</div>



@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script src="~/js/pages/MasterSetup/VendorPrefix.js"></script>
}


