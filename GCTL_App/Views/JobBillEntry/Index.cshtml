@model GCTL.Core.ViewModels.ClearAndF.Update.ShipmentUpdateViewModel

@{
    ViewData["Title"] = "Shipment Entry";
}

<link href="~/css/selectCSS.css" rel="stylesheet" />


<style>
    .sticky-bar {
        position: sticky;
        top: 65px;
        z-index: 1020; /* keep above other content */
    }
</style>



<div class="">
    <div class="">
        <div class="">

            <div class="d-flex flex-wrap justify-content-between align-items-center bg-white p-2 rounded shadow-sm border mb-3 sticky-bar">
                <div class="d-flex align-items-center py-1 ps-2">
                    <h1 class="fw-bold text-dark m-0" style="font-size: 0.95rem; letter-spacing: 0.5px;">
                        Bill Entry 
                    </h1>
                </div>

                <div class="d-flex flex-wrap align-items-end pe-1">
                    <button type="button" class="btn btn-phoenix-primary" id="saveBillEntryBtn">
                        <i class="fas fa-save text-success"></i>
                        <span>Save</span>
                    </button>
                    <button type="button" class="btn btn-phoenix-primary">
                        <i class="fas fa-trash text-danger"></i>
                        <span>Delete</span>
                    </button>
                    <button type="button" id="btnClear" class="btn btn-phoenix-primary">
                        <i class="fas fa-sync text-primary"></i>
                        <span>Clear</span>
                    </button>
                    <button type="button" class="btn btn-phoenix-primary">
                        <i class="fas fa-print text-dark"></i>
                        <span>Print</span>
                    </button>
                    <button type="button" class="btn btn-phoenix-primary">
                        <i class="fas fa-star text-warning"></i>
                        <span>Favt</span>
                    </button>
                </div>
            </div>

            <div class="px-4 px-lg-6 bg-body-emphasis rounded">
                <div class="mb-3 mt-5">
                    <div id="jobSummary">
                        <div class="row g-3 justify-content-between align-items-end mb-4">
                            <div class="col-12 col-sm-auto">
                                <div class="d-flex align-items-center">
                                    <!-- Filter by Customer Name (dropdown or select2 if you have many customers) -->
                                    <div class="dropdown me-3">
                                        <select class="form-select searchableSelect" id="customerFilter" asp-items="ViewBag.CustomerName as SelectList">
                                            <option value="">All Customers</option>
                                            <!-- Options will be populated dynamically or via server -->
                                        </select>
                                    </div>

                                    <!-- Filter by Shipment Mode -->
                                    <div class="dropdown me-3">
                                        <select class="form-select searchableSelect" id="shipmentModeFilter" asp-items="ViewBag.ShipmentMode as SelectList">
                                            <option value="">All Shipment Modes</option>
                                            <!-- Options: Air, Sea, Land, etc. -->
                                        </select>
                                    </div>

                                    <!-- Filter by Date Range -->
                                    <div class="me-3">
                                        <div class="input-group">
                                            <span class="input-group-text">From</span>
                                            <input type="date" class="form-control datetimepicker caiCon" id="dateFrom">
                                            <span class="input-group-text">To</span>
                                            <input type="date" class="form-control datetimepicker caiCon" id="dateTo">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-auto">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <input class="form-control" id="searchInput" type="text" placeholder="Search">
                                    </div>
                                    <div class="dropdown me-3">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Showing</span>
                                            </div>
                                            <select class="form-select" id="pageSizeSelect">
                                                <option value="5">5</option>
                                                <option value="10">10</option>
                                                <option value="25">25</option>
                                                <option value="50">50</option>
                                                <option value="100">100</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive ms-n1 ps-1 scrollbar">
                            <table class="table fs-9 mb-0 border-top border-translucent dyn-tableDrag" id="JobSettingsTable">
                                <thead>
                                    <tr>
                                        <th class="sort white-space-nowrap align-middle ps-0" scope="col" data-sort="JobNo">Job No</th>
                                        <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="ShipmentMode">Shipment Mode</th>
                                        <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="JobDate">Job Date</th>
                                        <th class="sort white-space-nowrap align-middle ps-2 text-center" scope="col" data-sort="CustomerName">Customer Name</th>
                                        <th class="sort white-space-nowrap align-middle ps-2 text-end" scope="col" data-sort="DocReceivedDate">Doc Received Date</th>

                                    </tr>
                                </thead>
                                <tbody class="list" id="job-settings-table">
                                    <!-- Table rows will be populated here dynamically -->
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-wrap align-items-center justify-content-between py-3 pe-0 fs-9 border-bottom border-translucent">
                            <div class="d-flex">
                                <p class="mb-0 d-none d-sm-block me-3 fw-semibold text-body" id="dataListInfo"></p>
                            </div>
                            <div class="d-flex">
                                <button class="page-link" id="paginationPrev"><span class="fas fa-chevron-left"></span></button>
                                <ul class="mb-0 pagination" id="paginationNumbers"></ul>
                                <button class="page-link pe-0" id="paginationNext"><span class="fas fa-chevron-right"></span></button>
                            </div>
                        </div>




                    </div>
                </div>
            </div>

            <div class="bg-body-emphasis pt-1 px-4 rounded">

                <input type="hidden" id="sdId" />

                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Bill No</label>
                        <input class="form-control" readonly id="billNo" />
                        <span class="text-danger"></span>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label class="form-label">Bill Date</label>
                        <input type="date" class="form-control datetimepicker caiCon" id="billDate" />
                        <span class="text-danger"></span>
                    </div>

                    <!-- Shipment Mode -->
                    @*


            <div class="col-lg-4 col-md-6">
